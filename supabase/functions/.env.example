# AI 服务的完整接口地址。支持 OpenAI 兼容的 Chat Completions 或 Responses 接口。
AI_API_URL=https://api.example.com/v1/chat/completions

# 只保存在 Supabase Edge Function secrets 中，绝对不要提交到 GitHub。
AI_API_KEY=请填写你的_API_KEY

# 接口对应的模型名称。
AI_MODEL=请填写模型名称

# 允许调用函数的网页来源，多个地址使用英文逗号分隔。
ALLOWED_ORIGINS=https://eggowang.github.io,http://127.0.0.1:4173,http://localhost:4173
